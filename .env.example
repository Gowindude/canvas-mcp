# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored and must never be committed.

# A Canvas API access token. Generate one from:
#   Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
# See the README for detailed, step-by-step instructions.
CANVAS_API_TOKEN=your_token_here

# The base URL of your institution's Canvas instance (no trailing /api/v1).
# Example for Georgia Tech:
CANVAS_BASE_URL=https://gatech.instructure.com

# Safety switch for WRITE operations (posting to discussions, replying,
# submitting assignments, commenting). Leave as "false" to keep the server
# strictly read-only. Set to "true" only when you want Claude to be able to
# modify Canvas on your behalf. Changing this requires fully restarting your MCP
# client (e.g. Claude Desktop). Note: writes are not idempotent — a retried call
# can double-post or double-submit.
CANVAS_ENABLE_WRITES=false

# ---------------------------------------------------------------------------
# Remote deployment (HTTP transport + GitHub OAuth) — only needed on Render
# ---------------------------------------------------------------------------
# Claude.ai custom connectors require OAuth 2.0; static bearer tokens are not
# yet supported.  FastMCP's GitHubProvider wraps GitHub OAuth so users (you)
# authenticate via GitHub and receive a scoped FastMCP JWT.
#
# Steps:
#   1. Go to github.com/settings/developers → OAuth Apps → New OAuth App
#   2. Application name: canvas-mcp (or anything)
#   3. Homepage URL: https://<your-service>.onrender.com
#   4. Authorisation callback URL: https://<your-service>.onrender.com/auth/callback
#   5. Copy the generated Client ID and Client Secret below.
#   6. Set MCP_SERVER_BASE_URL to your public Render URL (no trailing slash).
#
# These vars are ignored when running locally (PORT is not set → stdio mode).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MCP_SERVER_BASE_URL=https://your-canvas-mcp.onrender.com
# Stable secret that encrypts the OAuth client registry on disk.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Without this, every server restart invalidates registered clients.
MCP_JWT_SIGNING_KEY=
# Upstash Redis URL for persistent OAuth client storage (survives redeploys).
# Sign up free at upstash.com → Create database → copy the Redis URL.
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=
